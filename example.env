# =============================================================================
# Interactive Brokers Connection Settings
# =============================================================================
IB_HOST=127.0.0.1
#IB_HOST=192.168.1.100
IB_USERNAME=your_username
IB_PASSWORD=your_password

# TRADING_MODE is consumed by the IB GATEWAY CONTAINER (gnzsnz/ib-gateway).
# It selects which IB account the Gateway logs into. It is NOT a data-source
# switch -- see DATA_MODE below.
TRADING_MODE=paper

# -----------------------------------------------------------------------------
# Port selection: read this before changing IB_PORT
# -----------------------------------------------------------------------------
# The gnzsnz/ib-gateway image runs IB Gateway bound to CONTAINER-localhost on
# 4001 (live) / 4002 (paper). Those ports are NOT reachable from outside the
# container. The image runs socat to relay:
#
#     container 4003  -> gateway 4001  (live)
#     container 4004  -> gateway 4002  (paper)
#
# So the correct port depends on where you are connecting FROM:
#
#   Trader container -> ajj-ib-gateway over the docker network : 4004 (paper)
#   Your Mac         -> 127.0.0.1  (compose maps host 4002 -> container 4004) : 4002
#
# The app runs inside the trader container, so it uses 4004.
IB_PORT=4004
## Live (socat): 4003  -- do not enable while paper-only
## TWS direct (not used in this setup): 7497 paper / 7496 live

# Trading Mode (true = paper trading, false = live)
PAPER_TRADING=true

# =============================================================================
# DATA_MODE -- where price bars come from
# =============================================================================
# Deliberately SEPARATE from TRADING_MODE/PAPER_TRADING. Those choose which
# ACCOUNT you are pointed at; this chooses where BARS come from. Conflating the
# two is how you end up trading against an account you did not intend.
#
#   realtime : ib.reqRealTimeBars (5-sec). Requires a paid IB market data
#              subscription. The only mode that can trade a live breakout.
#   delayed  : delayed ticks aggregated to bars, market data type 3. No
#              subscription needed, but ~15 minutes late -- observation only.
#   replay   : a past session replayed as if live. No subscription, no market
#              hours needed. NEVER places an order. This is the correctness gate.
DATA_MODE=replay

# Optional: Override config file location
# CONFIG_FILE=config/options-trader-config.yaml

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
